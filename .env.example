# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://goeddoen.net
NEXT_PUBLIC_SITE_NAME=Levende Gemeenschap

# ── AWS / content storage (design D2, D4) ────────────────────────────────────
AWS_REGION=eu-central-1
S3_CONTENT_BUCKET=
S3_MEDIA_BUCKET=
CLOUDFRONT_DISTRIBUTION_ID=
NEXT_PUBLIC_MEDIA_BASE_URL=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Interim admin auth (design D6 interim note): a single admin password + a
# secret used to sign the session cookie. Set a strong value for both in prod.
AUTH_SECRET=
ADMIN_PASSWORD=
# Future magic-link email via Auth.js + Amazon SES:
AUTH_URL=http://localhost:3000
EMAIL_FROM=no-reply@goeddoen.net
SES_REGION=eu-central-1

# ── Google Maps (design D8, consent-gated) ───────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Google Analytics (consent-gated) ─────────────────────────────────────────
# Left empty outside production: with no ID the tag is never injected.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
